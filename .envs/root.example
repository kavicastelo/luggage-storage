# =============================================================================
# Global Luggage Storage Marketplace — Root Monorepo Environment Template
# =============================================================================
# Used for root-level scripts, Docker compose development stacks, and workspace runners.
# Copy to .env in repository root for local development.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL & PostGIS (Local Docker default)
DATABASE_URL=postgresql://luggage_user:luggage_password@localhost:5432/luggage_storage_dev
MIGRATION_DATABASE_URL=postgresql://luggage_migrator:migrator_password@localhost:5432/luggage_storage_dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Security, CORS & Cryptographic Secrets (Placeholders only — generate random strings)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
APP_PUBLIC_URL=http://localhost:5173
API_PREFIX=/api/v1
DB_IDENTITY_KEY_ID=active
DB_IDENTITY_SECRET=REPLACE_WITH_RANDOM_HMAC_SECRET_MINIMUM_32_CHARACTERS
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_AES256_SECRET_MINIMUM_32_CHARACTERS
PAYOUT_ENCRYPTION_KEY_PREVIOUS=
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_MINIMUM_32_CHARACTERS
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECRET=REPLACE_WITH_RANDOM_COOKIE_SECRET_MINIMUM_32_CHARACTERS
RATE_LIMIT_HASH_SECRET=REPLACE_WITH_RANDOM_RATE_LIMIT_SECRET_MINIMUM_32_CHARACTERS

# Transactional Email (Local development defaults to console or noop when unset)
EMAIL_PROVIDER=console
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@luggagestorage.lk
EMAIL_FROM_NAME=Luggage Storage Marketplace

# Object Storage (Local development uses memory adapter)
STORAGE_PROVIDER=memory
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=luggage-storage-dev
R2_PUBLIC_URL=
R2_PRESIGNED_TTL_SECONDS=900

# Payment Gateway & Custody Security (Local development uses signed sandbox gateway)
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_HMAC_SECRET_MINIMUM_32_CHARS
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX_MODE=true
PAYHERE_NOTIFY_URL=http://localhost:3000/api/v1/payments/webhooks/payhere
PAYHERE_RETURN_URL=http://localhost:5173/booking/confirm
PAYHERE_CANCEL_URL=http://localhost:5173/booking/confirm?cancelled=1
CUSTODY_TOKEN_HMAC_SECRET=REPLACE_WITH_RANDOM_CUSTODY_HMAC_SECRET_MINIMUM_32_CHARS

# Web Frontend Preview Policy
VITE_ENABLE_DEMO_PREVIEW=false

