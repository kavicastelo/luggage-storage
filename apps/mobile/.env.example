# -----------------------------------------------------------------------------
# Mobile Application Environment Configuration (Expo)
# -----------------------------------------------------------------------------

# Fastify API Base URL
# Development on Android Emulator usually uses http://10.0.2.2:3000/api/v1
# Development on iOS Simulator uses http://localhost:3000/api/v1
# Physical devices require your development machine's local IP address (e.g. http://192.168.1.100:3000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Security Notice:
# Never store secrets, database passwords, or private keys in Expo environment files.
# Mobile refresh tokens are stored securely in hardware-backed Expo SecureStore.

