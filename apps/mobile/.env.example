# -----------------------------------------------------------------------------
# Mobile Application Environment Configuration (Expo)
# -----------------------------------------------------------------------------

# Fastify API Base URL
# Development on Android Emulator usually uses http://10.0.2.2:3000/api/v1
# Development on iOS Simulator uses http://localhost:3000/api/v1
# Physical devices require your development machine's local IP address (e.g. http://192.168.1.100:3000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# MapTiler Key for Vector/Raster Maps (optional; map falls back gracefully when unset)
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_API_KEY=

# Security Notice:
# Never store secrets, database passwords, Stripe Secret Keys, PayPal Secret Keys, or private keys in Expo environment files.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, and PAYPAL_CLIENT_SECRET belong strictly on apps/api.
# Payments use Stripe Elements (web/in-app) and PayPal Checkout (Linking.openURL).
# Mobile refresh tokens are stored securely in hardware-backed Expo SecureStore.

