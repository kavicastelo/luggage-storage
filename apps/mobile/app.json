{
  "expo": {
    "name": "LuggageStorage",
    "slug": "luggage-storage",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "luggagestorage",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luggagestorage.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Luggage Storage requires camera access to scan luggage QR custody passes.",
        "NSLocationWhenInUseUsageDescription": "Luggage Storage uses your location to discover nearby storage facilities and navigate to luggage drop-off locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A192F"
      },
      "package": "com.luggagestorage.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A192F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "local-phase-1a-placeholder"
      }
    }
  }
}