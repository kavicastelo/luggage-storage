# Web Application Environment Configuration
VITE_API_URL=http://localhost:3000/api/v1

# Demo Preview Policy (false by default in production; set to true only for read-only sandbox environments)
VITE_ENABLE_DEMO_PREVIEW=false

# Post-MVP Feature Flags (false by default until explicitly launched)
VITE_FEATURE_REVIEWS=false
VITE_FEATURE_PROMOTIONS=false

# MapTiler Static Map Key (optional; map falls back gracefully when unset)
VITE_MAPTILER_KEY=

# Payment Configuration & Security Note:
# Primary: Stripe Elements (client-side card collection using server-issued clientSecret)
# Alternative: PayPal Checkout (redirect via server-created order approval link)
# Never expose STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PAYPAL_CLIENT_SECRET,
# or any server secrets in VITE_* environment variables. All payments are server-authoritative.
