# Web Application Environment Configuration
VITE_API_URL=http://localhost:3000/api/v1

# Demo Preview Policy (false by default in production; set to true only for read-only sandbox environments)
VITE_ENABLE_DEMO_PREVIEW=false

# PayHere Web Checkout Security Note:
# Never add PAYHERE_WEB_MERCHANT_SECRET or any Merchant Secret to VITE_* variables.
# Web checkout domain must match the origin registered in PayHere Portal -> Domains & Credentials
# and PAYHERE_RETURN_URL / PAYHERE_CANCEL_URL on the API.
