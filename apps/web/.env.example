# -----------------------------------------------------------------------------
# Web Application Environment Configuration
# -----------------------------------------------------------------------------

# API Base URL
# Development default points to Fastify API service.
# If using Vite dev proxy, "/api/v1" can be used to prevent cross-origin cookie restrictions.
# In production, set to your API domain (e.g. https://api.luggagestorage.com/api/v1).
VITE_API_URL=http://localhost:3000/api/v1

# Application branding
VITE_APP_NAME="Global Luggage Storage"

# Note: Never place sensitive credentials, database passwords, or JWT secrets in Vite public environment files.
# Refresh tokens are managed exclusively through HTTP-only, SameSite=Strict cookies set by the backend.
