{
  "name": "@luggage-storage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.3",
    "@luggage-storage/contracts": "workspace:*",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pg": "^8.11.5",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@luggage-storage/eslint-config": "workspace:*",
    "@luggage-storage/typescript-config": "workspace:*",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.14.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}