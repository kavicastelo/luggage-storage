# Fastify Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL & PostGIS Configuration
DATABASE_URL=postgresql://luggage_user:luggage_password@localhost:5432/luggage_storage_dev
MIGRATION_DATABASE_URL=postgresql://luggage_migrator:migrator_password@localhost:5432/luggage_storage_dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Security, CORS & Rate Limiting
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
APP_PUBLIC_URL=http://localhost:5173
API_PREFIX=/api/v1
RATE_LIMIT_HASH_SECRET=replace_with_32_char_minimum_hmac_secret_in_production

# Transactional Email Configuration (Zoho Mail Production SMTP)
EMAIL_PROVIDER=zoho

ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRESIGNED_TTL_SECONDS=
