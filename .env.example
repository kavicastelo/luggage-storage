# Global Luggage Storage Marketplace — Root Environment Example
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL & PostGIS Configuration
DATABASE_URL=postgresql://luggage_user:luggage_password@localhost:5432/luggage_storage_dev
MIGRATION_DATABASE_URL=postgresql://luggage_migrator:migrator_password@localhost:5432/luggage_storage_dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Security, CORS & Cryptographic Secrets (Placeholders only)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
APP_PUBLIC_URL=http://localhost:5173
API_PREFIX=/api/v1
DB_IDENTITY_KEY_ID=active
DB_IDENTITY_SECRET=REPLACE_WITH_RANDOM_HMAC_SECRET_MINIMUM_32_CHARACTERS
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_AES256_SECRET_MINIMUM_32_CHARACTERS
PAYOUT_ENCRYPTION_KEY_PREVIOUS=
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_MINIMUM_32_CHARACTERS
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECRET=REPLACE_WITH_RANDOM_COOKIE_SECRET_MINIMUM_32_CHARACTERS
RATE_LIMIT_HASH_SECRET=replace_with_32_char_minimum_hmac_secret_in_production

# Transactional Email Configuration (Zoho Mail Production SMTP)
EMAIL_PROVIDER=zoho

ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Web Frontend Demo Preview Policy (false by default in production)
VITE_ENABLE_DEMO_PREVIEW=false

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRESIGNED_TTL_SECONDS=

# Payment Gateway & Custody Security Configuration (Stripe Primary, PayPal Alternative)
PAYMENT_PROVIDER=stripe
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_HMAC_SECRET_MINIMUM_32_CHARS

# Stripe Configuration (Primary Provider)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# PayPal Configuration (Alternative Provider)
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=REPLACE_WITH_PAYPAL_WEBHOOK_ID
PAYPAL_SANDBOX_MODE=true

# PayHere Configuration (DECOMMISSIONED — Retained solely for historical read-only / legacy test runner compatibility)
# PAYHERE_MERCHANT_ID=
# PAYHERE_WEB_MERCHANT_SECRET=
# PAYHERE_MOBILE_MERCHANT_SECRET=
# PAYHERE_SANDBOX_MODE=true

CUSTODY_TOKEN_HMAC_SECRET=REPLACE_WITH_RANDOM_CUSTODY_HMAC_SECRET_MINIMUM_32_CHARS

# Maps, Routing & Geocoding Configuration
MAPS_PROVIDER=maptiler
MAPTILER_API_KEY=
VITE_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_KEY=
